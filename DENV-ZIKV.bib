doi = {10.1093/NAR/GKAC1052},
file = {:C$\backslash$:/Users/alfon/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/The UniProt Consortium - 2023 - UniProt the Universal Protein Knowledgebase in 2023.pdf:pdf},
