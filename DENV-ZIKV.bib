publisher = {Virology},
title = {{Structure-function insights into chikungunya virus capsid protein: Small molecules targeting capsid hydrophobic pocket.}},
url = {http://www.ncbi.nlm.nih.gov/pubmed/29306785},
volume = {515},
year = {2018}
}
